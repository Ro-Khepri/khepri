<?xml version="1.0"?>
<sc:item xmlns:sc="http://www.utc.fr/ics/scenari/v3/core" xmlns:sp="http://www.utc.fr/ics/scenari/v3/primitive" xmlns:op="utc.fr:ics/opale3" version="1"><op:expUc><op:uM><sp:title><op:title><sc:para xml:space="preserve">Capteurs de température pour la maquette : LM35CZ, LM35DZ, module OPENSE030 et travaux de l'IUT</sc:para></op:title></sp:title><sp:sTitle><op:title><sc:para xml:space="preserve">Grain 6.1.2B</sc:para></op:title></sp:sTitle><sp:info><op:info><sp:cpyrgt><op:sPara><sc:para xml:space="preserve">slt Dominique GUILAVOGUI</sc:para></op:sPara></sp:cpyrgt></op:info></sp:info></op:uM><sp:pb><op:pb><sp:info><op:pbTi><sp:filters><op:filter><sp:exclude>short</sp:exclude></op:filter></sp:filters><sp:title><op:title><sc:para xml:space="preserve">Objectifs de ce grain de contenu</sc:para></op:title></sp:title></op:pbTi><op:res><sp:txt><op:txt><sc:para xml:space="preserve">Comparer trois références de capteurs de température à base de LM35, proposer leur implantation sur la maquette KHEPRI — revêtement photovoltaïque, batterie, moteur — et présenter l'usage qu'en font les étudiants de l'IUT de Salon-de-Provence dans leur chaîne d'acquisition (source : stage de fin d'études #EAE20# SFE 2025-02, mémoire de SLT Dominique GUILAVOGUI, cursus licence, juin 2025, sous la direction de M. Patrick PRODHOME, annexe B4 « Capteurs utilisés » du 21 mai 2025).</sc:para></op:txt></sp:txt></op:res></sp:info><sp:info><op:pbTi><sp:title><op:title><sc:para xml:space="preserve">Trois références comparées</sc:para></op:title></sp:title></op:pbTi><op:res><sp:txt><op:txt><sc:table role=""><sc:caption xml:space="preserve">Capteurs de température à base de LM35 comparés en 2025</sc:caption><sc:column width="20"/><sc:column width="20"/><sc:column width="20"/><sc:column width="20"/><sc:column width="20"/><sc:row><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Référence</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Description</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Plage de mesure</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Boîtier</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Prix unitaire HT relevé en 2025</sc:inlineStyle></sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">LM35CZ</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">capteur analogique précis</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">−40 à +110 °C</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">TO-92</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">5,30 €</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">LM35DZ</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">version économique</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">0 à +100 °C</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">TO-92</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">2,00 €</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">OPENSE030</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">module équipé d'un LM35</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">0 à +100 °C</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">carte montée avec connecteur</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">4,00 €</sc:para></sc:cell></sc:row></sc:table><sc:itemizedList><sc:listItem><sc:para xml:space="preserve">Le <sc:inlineStyle role="emp">LM35CZ</sc:inlineStyle>, à grande plage, convient aux mesures en extérieur.</sc:para></sc:listItem><sc:listItem><sc:para xml:space="preserve">Le <sc:inlineStyle role="emp">LM35DZ</sc:inlineStyle> suffit pour les mesures internes, sur la batterie ou le moteur.</sc:para></sc:listItem><sc:listItem><sc:para xml:space="preserve">Le module <sc:inlineStyle role="emp">OPENSE030</sc:inlineStyle> facilite le prototypage rapide grâce à un câblage simple.</sc:para></sc:listItem></sc:itemizedList></op:txt></sp:txt></op:res></sp:info><sp:info><op:pbTi><sp:title><op:title><sc:para xml:space="preserve">Implantations proposées sur la maquette</sc:para></op:title></sp:title></op:pbTi><op:res><sp:txt><op:txt><sc:table role=""><sc:caption xml:space="preserve">Implantation proposée des capteurs de température</sc:caption><sc:column width="33"/><sc:column width="33"/><sc:column width="33"/><sc:row><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Zone de mesure</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Capteur conseillé</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Justification</sc:inlineStyle></sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">aile, près des panneaux photovoltaïques</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">LM35CZ ou OPENSE030</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">suivi de la température de surface et détection de surchauffe au-delà de 60 °C</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">batterie</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">LM35DZ</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">surveillance thermique pendant la charge et la décharge</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">zone moteur</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">LM35DZ</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">détection des échauffements</sc:para></sc:cell></sc:row></sc:table><sc:para xml:space="preserve">Il faut éviter de masquer les cellules avec le capteur : le coller à l'arrière ou à côté, avec une gaine thermique, est préférable.</sc:para></op:txt></sp:txt></op:res></sp:info><sp:info><op:pbTi><sp:title><op:title><sc:para xml:space="preserve">Les capteurs dans les travaux de l'IUT</sc:para></op:title></sp:title></op:pbTi><op:res><sp:txt><op:txt><sc:para xml:space="preserve">Les étudiants du département génie électrique et informatique industrielle de l'IUT de Salon-de-Provence collectent les données avec une carte Arduino Mega et un Grove Shield. Les LM35 sont reliés aux entrées analogiques ; les valeurs sont lues en temps réel sur un écran LCD de 2 × 16 caractères, dont un interrupteur fait alterner l'affichage, et enregistrées avec leur date et leur heure sur une carte SD grâce à une horloge RTC. Une alerte de surchauffe des panneaux s'affiche dès 60 °C, pour prévenir les risques structurels.</sc:para><sc:table role=""><sc:caption xml:space="preserve">Composants de la chaîne d'acquisition des étudiants de l'IUT</sc:caption><sc:column width="33"/><sc:column width="33"/><sc:column width="33"/><sc:row><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Fonction</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Composant</sc:inlineStyle></sc:para></sc:cell><sc:cell><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Référence ou détail</sc:inlineStyle></sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">microcontrôleur</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">Arduino Mega 2560</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">A000067</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">affichage</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">écran LCD RGB Grove</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">2 × 16 caractères</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">température</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">modules LM35</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">principalement LM35DZ</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">stockage</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">shield SD et carte SD de 8 Go</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">—</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">horloge</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">RTC DS1307 Grove</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">pile CR1225</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">connexions</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">Grove Shield</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">pour la modularité</sc:para></sc:cell></sc:row><sc:row><sc:cell><sc:para xml:space="preserve">autres</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">relais de 30 A, diviseurs de tension, capteurs de courant ±10 A, ±15 A et 0-10 A</sc:para></sc:cell><sc:cell><sc:para xml:space="preserve">voir le rapport de l'IUT</sc:para></sc:cell></sc:row></sc:table><sc:para xml:space="preserve">Ces travaux ont orienté les recherches du binôme de l'École sur les capteurs, les convertisseurs et le type de montage ; pour diversifier les mesures, celui-ci a aussi testé des capteurs DHT22 et AHT10 (grain 6.1.2). Le banc d'acquisition de l'École est décrit dans le grain 6.2.1 et le schéma d'instrumentation de l'IUT dans le grain 3.1.4.</sc:para><sc:para xml:space="preserve"><sc:inlineStyle role="emp">Note de relecture</sc:inlineStyle> : la plage de 0 à 100 °C du LM35DZ est conforme à la fiche Texas Instruments ; le seuil d'alerte de 60 °C est à harmoniser avec la limite de 65 °C retenue pour les cellules et la résine (grains 3.1.2D et 6.1.2). Le rapport de l'IUT cité n'est pas dans les dossiers : à récupérer. Les prix sont indicatifs.</sc:para></op:txt></sp:txt></op:res></sp:info></op:pb></sp:pb></op:expUc></sc:item>